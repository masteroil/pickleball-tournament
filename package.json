{
  "name": "pickleball-tournament-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "VITE_API_URL=https://pickleball-tournament-jd9h.onrender.com npm run build",
    "test": "vitest run",
    "e2e": "playwright test",
    "api": "node --env-file-if-exists=api/.env --import tsx api/server.ts",
    "account": "node --env-file-if-exists=api/.env --import tsx api/account.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "mongodb": "^6.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
